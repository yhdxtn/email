# EXAMPLE ONLY. Do not overwrite existing website/mail renewal locations.
server {
    listen 443 ssl;
    server_name admin.example.test;
    ssl_certificate /etc/letsencrypt/live/admin.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.test/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 5m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Apply an office/VPN IP allowlist here before exposing the admin interface.
    # allow 192.0.2.10; deny all;
    # If a trusted HAProxy is in front, declare its exact source with set_real_ip_from
    # and configure real_ip_header/real_ip_recursive before using $remote_addr below.
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        # Overwrite any client-supplied value. The app must trust only the Caddy peer CIDR.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 150s;
    }
}
server {
    listen 80;
    server_name admin.example.test;
    return 301 https://$host$request_uri;
}
