{
  "instance_id": "replace-node-instance-id",
  "adapter": "postfix-dovecot-passwd-v1",
  "bind": "127.0.0.1",
  "port": 9089,
  "state_root": "/var/lib/astrogate-agent",
  "domains": ["example.test"],
  "forward_domains": [],
  "write_enabled": false,
  "approval_id": "",
  "allow_helper": false,
  "mail_root": "/var/lib/vmail",
  "mail_uid": 5000,
  "mail_gid": 5000,
  "mailbox_file": "/etc/astrogate-agent/maps/users",
  "recipient_map": "/etc/astrogate-agent/maps/recipients",
  "alias_map": "/etc/astrogate-agent/maps/aliases",
  "signing_key_file": "/etc/astrogate-agent/secrets/signing-key",
  "backup_key_file": "/etc/astrogate-agent/secrets/backup-key",
  "backup_root": "/var/lib/astrogate-agent/backups",
  "drill_root": "/var/lib/astrogate-agent/drills",
  "backup_sources": [
    {"label": "maildir", "path": "/var/lib/vmail"},
    {"label": "mail-maps", "path": "/etc/astrogate-agent/maps"},
    {"label": "agent-state", "path": "/var/lib/astrogate-agent/backup-state"}
  ],
  "backup_coverage": "declared_files_only_not_full_mail_stack",
  "max_backup_bytes": 268435456,
  "max_backup_files": 20000,
  "backup_timeout_seconds": 80,
  "tls_cert_file": "/etc/astrogate-agent/tls/server.pem",
  "tls_key_file": "/etc/astrogate-agent/tls/server.key",
  "tls_ca_file": "/etc/astrogate-agent/tls/ca.pem",
  "client_cert_sha256": "REPLACE_WITH_GENERATED_CONTROL_CLIENT_CERT_SHA256",
  "mail_hostname": null,
  "probe_ip": null,
  "max_ledger_jobs": 500000
}
